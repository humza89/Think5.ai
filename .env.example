# ============================================
# Application
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Supabase Configuration
# ============================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ============================================
# Resend Email Configuration
# ============================================
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="Think5 <noreply@yourdomain.com>"

# ============================================
# Database — Supabase Postgres + PgBouncer
# ============================================
# DATABASE_URL: Use the Supabase POOLER endpoint (port 6543) for all
# application queries. PgBouncer (transaction mode) aggregates connections
# across serverless function instances so each instance only needs a
# small pool (default 5 via PRISMA_CONNECTION_LIMIT).
#
# DIRECT_URL: Non-pooler endpoint (port 5432) used ONLY by Prisma Migrate.
# PgBouncer breaks prepared statements in migration mode, so migrations
# must go direct.
#
# In production, set these in the Vercel environment, NOT in .env.
DATABASE_URL="postgresql://user:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@db.your-project.supabase.co:5432/postgres"

# Per-instance connection pool size. Default 5 with PgBouncer is optimal.
# Only raise if you see "pool_timeout" errors in Prisma logs AND the
# Supabase dashboard shows headroom on the backend connection count.
# PRISMA_CONNECTION_LIMIT=5

# ============================================
# OpenAI API
# ============================================
OPENAI_API_KEY="your-openai-api-key-here"

# ============================================
# JWT Secret (Legacy - use Supabase Auth instead)
# ============================================
JWT_SECRET="your-jwt-secret-key-here"

# ============================================
# Gemini AI (Aria Interview System)
# ============================================
GEMINI_API_KEY="your-gemini-api-key-here"

# ============================================
# Voice Relay (WebSocket proxy for Gemini Live)
# Deploy relay/server.ts to Fly.io, then set URL here.
# RELAY_JWT_SECRET must match between app and relay.
# ============================================
VOICE_RELAY_URL="wss://your-relay.fly.dev"
RELAY_JWT_SECRET="your-relay-jwt-secret-here"

# ============================================
# File Storage
# ============================================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# ============================================
# PII Encryption (Field-level AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================
PII_ENCRYPTION_KEY="your-64-character-hex-key-here"

# ============================================
# Secrets Vault (optional — for production)
# SECRETS_PROVIDER: "env" (default) | "aws" | "vault"
# ============================================
# SECRETS_PROVIDER="env"
# AWS_SECRET_ARN="arn:aws:secretsmanager:us-east-1:123456789:secret:paraform-prod"
# AWS_REGION="us-east-1"
# VAULT_ADDR="https://vault.yourdomain.com"
# VAULT_TOKEN="your-vault-token"
# VAULT_SECRET_PATH="secret/data/paraform"

# ============================================
# Upstash Redis — accelerator, never authoritative (Phase 0 T11)
# ============================================
# Required in Vercel production AND preview. Without it, rate limits and the
# voice session hot-cache are per-instance and /api/health reports
# durability=postgres; interviews still run on the Postgres ledger.
# UPSTASH_REDIS_REST_URL="https://<db>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."
# Bound on every Redis call from the web tier (ms). Upstash REST has no default timeout.
# REDIS_CALL_TIMEOUT_MS="3000"
# Redis loss is a durability downgrade (default). Set to "false" to restore the
# legacy fail-closed behaviour (voice-init 500/503 when Redis is unavailable).
# FF_P0_REDIS_SAFE_TO_FAIL="true"

# Relay (Fly) provider timeouts — set with `fly secrets set` or [env] in fly.toml
# GEMINI_CONNECT_TIMEOUT_MS="10000"
# GEMINI_SETUP_TIMEOUT_MS="15000"

# ============================================
# Observability — OpenTelemetry → Grafana Cloud (Phase 0 T12)
# ============================================
# Leave unset locally, in CI and in preview: instrumentation.ts then skips
# the SDK and lib/otel.ts becomes a no-op. Set all three in Vercel production
# (and optionally preview) once the Grafana Cloud stack exists.
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-prod-us-east-0.grafana.net/otlp"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64(instanceId:glc_token)>"
# OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
# OTEL_SERVICE_NAME="think5-web"
# OTEL_RESOURCE_ATTRIBUTES="deployment.environment=production"
