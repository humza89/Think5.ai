{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics (Mimir)",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_TEMPO",
      "label": "Grafana Cloud Traces (Tempo)",
      "type": "datasource",
      "pluginId": "tempo"
    }
  ],
  "uid": "think5-relay",
  "title": "Think5 · Voice Relay (Fly.io)",
  "description": "Connections, Gemini reconnects, buffer overflow and drain for service think5-relay. Until the relay ships the Node OpenTelemetry SDK (deferred to after T13 removes the committed relay/node_modules), these series come from the relay's /health JSON counters scraped by Grafana Alloy (see docs/ops/observability.md); the metric names below are the ones the SDK will emit so the dashboard needs no change.",
  "tags": [
    "think5",
    "phase-0",
    "T12"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(traces_spanmetrics_calls_total, deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": {
          "text": "production",
          "value": "production"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 7,
      "type": "timeseries",
      "title": "Active connections",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (fly_region) (relay_active_connections{service_name=\"think5-relay\",deployment_environment=~\"$env\"})",
          "legendFormat": "{{fly_region}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "New connections / min",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(relay_connections_total{service_name=\"think5-relay\",deployment_environment=~\"$env\"}[5m])) * 60",
          "legendFormat": "connections/min"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Gemini reconnects and failures",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(relay_gemini_reconnects_total{service_name=\"think5-relay\",deployment_environment=~\"$env\"}[5m])) * 60",
          "legendFormat": "reconnects/min"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(relay_gemini_reconnect_failures_total{service_name=\"think5-relay\",deployment_environment=~\"$env\"}[5m])) * 60",
          "legendFormat": "exhausted/min"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Buffer overflows / min",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(relay_buffer_overflows_total{service_name=\"think5-relay\",deployment_environment=~\"$env\"}[5m])) * 60",
          "legendFormat": "overflows/min"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Throughput",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(relay_messages_total{service_name=\"think5-relay\",deployment_environment=~\"$env\"}[5m]))",
          "legendFormat": "messages/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(relay_bytes_total{service_name=\"think5-relay\",deployment_environment=~\"$env\"}[5m]))",
          "legendFormat": "bytes/s"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Drain events and sessions terminated at drain timeout",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(relay_drain_started_total{service_name=\"think5-relay\",deployment_environment=~\"$env\"}[1h]))",
          "legendFormat": "drains (1h)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(relay_drain_force_terminated_total{service_name=\"think5-relay\",deployment_environment=~\"$env\"}[1h]))",
          "legendFormat": "force-terminated sessions (1h)"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Relay hello / handshake with correlation id",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Should approach 100% once every browser sends ?rid= (T12 hook change).",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(relay_connections_total{service_name=\"think5-relay\",deployment_environment=~\"$env\",has_request_id=\"true\"}[5m])) / sum(rate(relay_connections_total{service_name=\"think5-relay\",deployment_environment=~\"$env\"}[5m]))",
          "legendFormat": "share of sessions carrying rid"
        }
      ]
    }
  ]
}
