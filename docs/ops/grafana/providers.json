{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics (Mimir)",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_TEMPO",
      "label": "Grafana Cloud Traces (Tempo)",
      "type": "datasource",
      "pluginId": "tempo"
    }
  ],
  "uid": "think5-providers",
  "title": "Think5 · AI Providers",
  "description": "Latency, error rate, tokens and cost per provider/model. Latency and errors come from outbound HTTP client spans (@vercel/otel fetch instrumentation) to the provider hosts; tokens and cost come from the usage ledger counter usage.recorded (T16) with kind=ai.tokens.",
  "tags": [
    "think5",
    "phase-0",
    "T12"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(traces_spanmetrics_calls_total, deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": {
          "text": "production",
          "value": "production"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 20,
      "type": "timeseries",
      "title": "Provider call rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (server_address) (rate(traces_spanmetrics_calls_total{service_name=\"think5-web\",deployment_environment=~\"$env\",span_kind=\"SPAN_KIND_CLIENT\",server_address=~\"generativelanguage.googleapis.com|api.openai.com|api.anthropic.com|api.deepgram.com|api.elevenlabs.io\"}[5m]))",
          "legendFormat": "{{server_address}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Provider error ratio",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (server_address) (rate(traces_spanmetrics_calls_total{service_name=\"think5-web\",deployment_environment=~\"$env\",span_kind=\"SPAN_KIND_CLIENT\",status_code=\"STATUS_CODE_ERROR\",server_address=~\"generativelanguage.googleapis.com|api.openai.com|api.anthropic.com|api.deepgram.com|api.elevenlabs.io\"}[5m])) / sum by (server_address) (rate(traces_spanmetrics_calls_total{service_name=\"think5-web\",deployment_environment=~\"$env\",span_kind=\"SPAN_KIND_CLIENT\",server_address=~\"generativelanguage.googleapis.com|api.openai.com|api.anthropic.com|api.deepgram.com|api.elevenlabs.io\"}[5m]))",
          "legendFormat": "{{server_address}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Provider p95 latency",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, server_address) (rate(traces_spanmetrics_latency_bucket{service_name=\"think5-web\",deployment_environment=~\"$env\",span_kind=\"SPAN_KIND_CLIENT\",server_address=~\"generativelanguage.googleapis.com|api.openai.com|api.anthropic.com|api.deepgram.com|api.elevenlabs.io\"}[5m])))",
          "legendFormat": "{{server_address}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Tokens / hour by model",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "usage.recorded counter value is the token quantity for kind=ai.tokens.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (model) (increase(usage_recorded_total{service_name=\"think5-web\",deployment_environment=~\"$env\",kind=\"ai.tokens\"}[1h]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "AI cost / day (USD, from admin usage read model)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Emitted alongside ai.tokens once T16's meter is wired to OtelTelemetry (getTelemetry()). Until then read GET /api/admin/usage.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(usage_ai_cost_usd_total{service_name=\"think5-web\",deployment_environment=~\"$env\"}[24h]))",
          "legendFormat": "USD/day"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Budget gate decisions",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (reason) (rate(entitlement_check_total{service_name=\"think5-web\",deployment_environment=~\"$env\",feature=\"interview.create\"}[5m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
