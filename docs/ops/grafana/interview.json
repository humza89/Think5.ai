{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics (Mimir)",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_TEMPO",
      "label": "Grafana Cloud Traces (Tempo)",
      "type": "datasource",
      "pluginId": "tempo"
    }
  ],
  "uid": "think5-interview",
  "title": "Think5 · Interview Golden Path",
  "description": "Start latency, turn-commit latency, completion and degraded-mode rates for the candidate interview path.",
  "tags": [
    "think5",
    "phase-0",
    "T12"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(traces_spanmetrics_calls_total, deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": {
          "text": "production",
          "value": "production"
        }
      },
      {
        "name": "interview_id",
        "label": "Interview id",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 26,
      "type": "timeseries",
      "title": "voice-init p95 (interview start)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3000
              },
              {
                "color": "red",
                "value": 8000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service_name=\"think5-web\",deployment_environment=~\"$env\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\"POST /api/interviews/\\\\[id\\\\]/voice-init\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "turn-commit p99",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1500
              },
              {
                "color": "red",
                "value": 4000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_latency_bucket{service_name=\"think5-web\",deployment_environment=~\"$env\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\"POST /api/interviews/\\\\[id\\\\]/voice/turn-commit\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Interviews started vs completed / hour",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "From the T16 usage ledger counter (one event per interview, idempotent).",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(usage_recorded_total{service_name=\"think5-web\",deployment_environment=~\"$env\",kind=\"interview.started\"}[1h]))",
          "legendFormat": "started"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(usage_recorded_total{service_name=\"think5-web\",deployment_environment=~\"$env\",kind=\"interview.completed\"}[1h]))",
          "legendFormat": "completed"
        }
      ]
    },
    {
      "id": 29,
      "type": "stat",
      "title": "Completion rate (24h)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(usage_recorded_total{service_name=\"think5-web\",deployment_environment=~\"$env\",kind=\"interview.completed\"}[24h])) / sum(increase(usage_recorded_total{service_name=\"think5-web\",deployment_environment=~\"$env\",kind=\"interview.started\"}[24h]))",
          "legendFormat": "completion"
        }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Degraded-mode rate (text fallback / postgres-only durability)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "interview_degraded_total is emitted by T11 (durability downgrade, text fallback). Zero until T11 lands.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(interview_degraded_total{service_name=\"think5-web\",deployment_environment=~\"$env\"}[5m])) / sum(rate(usage_recorded_total{service_name=\"think5-web\",deployment_environment=~\"$env\",kind=\"interview.started\"}[5m]))",
          "legendFormat": "degraded share"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Interview route errors / hour",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (span_name) (increase(traces_spanmetrics_calls_total{service_name=\"think5-web\",deployment_environment=~\"$env\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\",span_name=~\".*/api/interviews/.*\"}[1h]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "table",
      "title": "Find an interview's traces",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Set the interview_id variable from a Support ID (first 8 chars match the interview id prefix).",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{ span.think5.interview_id = \"$interview_id\" } | select(span.think5.request_id, name, status)",
          "limit": 50
        }
      ]
    }
  ]
}
