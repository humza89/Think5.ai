{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics (Mimir)",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_TEMPO",
      "label": "Grafana Cloud Traces (Tempo)",
      "type": "datasource",
      "pluginId": "tempo"
    }
  ],
  "uid": "think5-queues",
  "title": "Think5 · Queues (Inngest)",
  "description": "Function lag, retries and dead-letter volume. Inngest Cloud exposes these via its Prometheus metrics export (Pro/Enterprise plan; scrape into Grafana Cloud Metrics with Alloy). The Vercel side of each run is also a server span on POST /api/inngest.",
  "tags": [
    "think5",
    "phase-0",
    "T12"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(traces_spanmetrics_calls_total, deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": {
          "text": "production",
          "value": "production"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 14,
      "type": "timeseries",
      "title": "Runs started / min by function",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (function_id) (rate(inngest_function_run_started_total{deployment_environment=~\"$env\"}[5m])) * 60",
          "legendFormat": "{{function_id}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Scheduling lag p95",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, function_id) (rate(inngest_function_run_scheduled_lag_seconds_bucket{deployment_environment=~\"$env\"}[5m])))",
          "legendFormat": "{{function_id}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Retries / min",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (function_id) (rate(inngest_step_retries_total{deployment_environment=~\"$env\"}[5m])) * 60",
          "legendFormat": "{{function_id}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Failed runs (dead-lettered) / hour",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (function_id) (increase(inngest_function_run_ended_total{deployment_environment=~\"$env\",status=\"Failed\"}[1h]))",
          "legendFormat": "{{function_id}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Backlog (queued runs)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (function_id) (inngest_function_run_queued{deployment_environment=~\"$env\"})",
          "legendFormat": "{{function_id}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "POST /api/inngest p95 on Vercel",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service_name=\"think5-web\",deployment_environment=~\"$env\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\".*/api/inngest.*\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
